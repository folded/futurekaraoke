{# Renders an event poster. Expects `ev` in context (an events entry). #}
<figure class="poster">
  <div class="poster-frame">
    <img src="{{ ev.poster.image }}" alt="{{ ev.poster.alt }}" class="poster-image" width="500" height="500" loading="lazy">
  </div>
  <figcaption class="poster-meta">
    <div class="poster-what">
      <p class="poster-title">{{ ev.tagline }}</p>
      {% if ev.note %}<p class="poster-note">{{ ev.note }}</p>{% endif %}
    </div>
    <div class="poster-where">
      <p class="poster-venue">{{ ev.venue }}</p>
      <p><a href="{{ ev.mapLink }}" target="_blank" rel="noopener">{{ ev.address }}</a></p>
      <p><time datetime="{{ ev.startISO }}">{{ ev.dateLabel }} · {{ ev.timeLabel }}</time></p>
    </div>
    {% if not ev.isPast %}
    <div class="poster-rsvp">
      <p class="poster-label">Free event — please RSVP</p>
      <p><a href="mailto:{{ site.email.tickets }}">{{ site.email.tickets }}</a></p>
    </div>
    <div class="poster-signup">
      <p class="poster-label">Take the stage</p>
      <p><a href="mailto:{{ site.email.speak }}">{{ site.email.speak }}</a></p>
    </div>
    {% endif %}
    {% if ev.funding %}<p class="poster-funding">{{ ev.funding }}</p>{% endif %}
  </figcaption>
</figure>
